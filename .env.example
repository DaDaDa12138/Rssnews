# Copy to .env and adjust. Docker Compose reads this file automatically for the
# ${VAR} substitutions in docker-compose.yml. Nothing here is required for a
# local run: every value has a working default.

# --- identity -------------------------------------------------------------
# Container user. Must match your host uid/gid so logs/ and static/ stay owned
# by you. Set both with:
#   sed -i "s/^CURRENT_UID=.*/CURRENT_UID=$(id -u)/; s/^CURRENT_GID=.*/CURRENT_GID=$(id -g)/" .env
CURRENT_UID=1000
CURRENT_GID=1000

# --- networking -----------------------------------------------------------
# Host port the reader is published on.
NEWSBLUR_PORT=8080
# Loopback ports for psql / redis-cli. Only change these to run a second
# instance next to this one; nothing inside the containers reads them.
# POSTGRES_HOST_PORT=5434
# REDIS_HOST_PORT=6579
# Public URL of this instance. Used for links in mail and as the default
# CSRF_TRUSTED_ORIGINS. Behind a TLS proxy this must be https://...
NEWSBLUR_URL=http://localhost:8080

# --- Django ---------------------------------------------------------------
# newsblur_web.settings is the single-user development profile (DEBUG=True).
# Switch to newsblur_web.settings_production for anything reachable from the
# internet; that profile also requires SECRET_KEY and ALLOWED_HOSTS below.
# DJANGO_SETTINGS_MODULE=newsblur_web.settings

# Required by settings_production, ignored by settings.py. Generate one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# SECRET_KEY=
# Comma separated host names, no wildcard. Example: rss.example.com
# ALLOWED_HOSTS=
# Defaults to NEWSBLUR_URL when empty.
# CSRF_TRUSTED_ORIGINS=
# Number of reverse proxies in front of Django (1 = one nginx/Caddy).
# ATTACK_BAN_PROXY_HOPS=1

# --- mail -----------------------------------------------------------------
# The console backend prints every message, including password-reset links, to
# the container log: `make logs`. Set a real backend for a public instance.
ADMIN_EMAIL=admin@localhost
SERVER_EMAIL=newsblur@localhost
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# --- translation sidecar --------------------------------------------------
# One-click translation of a story, POSTed to the deeplx container.
TRANSLATE_ENABLED=True
# TRANSLATE_ENDPOINT=http://newsblur_deeplx:1188/translate
# TRANSLATE_TOKEN=
# TRANSLATE_TARGET_LANG=ZH

# --- process tuning -------------------------------------------------------
# One gunicorn worker with 16 threads is right for a single-user instance:
# the work is I/O bound and every extra worker is another full copy of the
# Django app.
# GUNICORN_WORKERS=1
# GUNICORN_THREADS=16
# Celery is restarted by the supervisor once it exceeds this resident set.
# CELERY_WORKER_MEMORY_LIMIT_MB=750

# --- not forwarded by compose ---------------------------------------------
# settings.py also reads these straight from the environment, but
# docker-compose.yml does not pass them through. Add a line to the web
# service's environment list if you need one:
#   STORY_RETENTION_DAYS=180      STORY_RETENTION_MIN_PER_FEED=30
#   DAYS_OF_UNREAD=90             PRO_MINUTES_BETWEEN_FETCHES=15
#   DOMAIN_FETCHES_PER_MINUTE=30  MUTED_FEED_FETCH_MINUTES=360
#   SEARCH_FREE_TEXT_INCLUDES_BODY=True
